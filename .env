# ═══════════════════════════════════════════════════════════════
# InterviewKit AI — Environment Configuration
# ═══════════════════════════════════════════════════════════════

APP_NAME=interviewkit-ai
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5470
POSTGRES_DB=interviewkit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5470/interviewkit
DATABASE_URL_SYNC=postgresql://postgres:devpassword@localhost:5470/interviewkit

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── JWT & Auth ────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# ─── LLM APIs (server-default fallback only — per-user keys are stored encrypted in DB) ─
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-pro
LLM_PRIMARY_PROVIDER=anthropic
LLM_PRIMARY_MODEL=claude-sonnet-4-20250514
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o

# ─── Encryption (AES-256-GCM master key for per-user LLM API key storage) ──
AI_ENCRYPTION_MASTER_KEY=

# ─── Service Ports ─────────────────────────────────────────────
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
RESUME_SERVICE_PORT=8002
AI_ENGINE_PORT=8003
KIT_ORCHESTRATOR_PORT=8004
EXPORT_SERVICE_PORT=8005
FRONTEND_PORT=3000

# ─── Service URLs ──────────────────────────────────────────────
GATEWAY_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001
RESUME_SERVICE_URL=http://localhost:8002
AI_ENGINE_URL=http://localhost:8003
KIT_ORCHESTRATOR_URL=http://localhost:8004
EXPORT_SERVICE_URL=http://localhost:8005

# ─── File Storage ──────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_FREE_KITS_PER_MONTH=3
RATE_LIMIT_FREE_REQUESTS_PER_MINUTE=10
RATE_LIMIT_PRO_REQUESTS_PER_MINUTE=60

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
