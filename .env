# ──────────────────────────────────────────────
# InterviewKit AI — Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ═══ Application ═══
APP_NAME=InterviewKit AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# ═══ Database (PostgreSQL) ═══
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interviewkit
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/interviewkit
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ═══ Redis ═══
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ═══ JWT Auth ═══
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══ AI/LLM ═══
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-20250514

# ═══ Stripe Billing ═══
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx

# ═══ File Storage ═══
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# ═══ Service Ports ═══
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
RESUME_PARSER_PORT=8002
AI_ENGINE_PORT=8003
KIT_MANAGER_PORT=8004
PDF_GENERATOR_PORT=8005
BILLING_SERVICE_PORT=8006

# ═══ Service URLs (internal) ═══
AUTH_SERVICE_URL=http://localhost:8001
RESUME_PARSER_URL=http://localhost:8002
AI_ENGINE_URL=http://localhost:8003
KIT_MANAGER_URL=http://localhost:8004
PDF_GENERATOR_URL=http://localhost:8005
BILLING_SERVICE_URL=http://localhost:8006

# ═══ Frontend ═══
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ═══ Google OAuth ═══
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
