# ═══════════════════════════════════════════════════════════════
# InterviewKit AI — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ─── Application ───────────────────────────────────────────────
APP_NAME=interviewkit-ai
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interviewkit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ─── JWT & Auth ────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# ─── LLM APIs ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-pro
LLM_PRIMARY_PROVIDER=anthropic
LLM_PRIMARY_MODEL=claude-sonnet-4-20250514
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o

# ─── Encryption (AES-256-GCM master key for per-user LLM API key storage) ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_ENCRYPTION_MASTER_KEY=change-me-generate-with-secrets-token-urlsafe-48

# ─── Service Ports ─────────────────────────────────────────────
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
RESUME_SERVICE_PORT=8002
AI_ENGINE_PORT=8003
KIT_ORCHESTRATOR_PORT=8004
EXPORT_SERVICE_PORT=8005
FRONTEND_PORT=3000

# ─── Service URLs (for inter-service communication) ────────────
GATEWAY_URL=http://localhost:${GATEWAY_PORT}
AUTH_SERVICE_URL=http://localhost:${AUTH_SERVICE_PORT}
RESUME_SERVICE_URL=http://localhost:${RESUME_SERVICE_PORT}
AI_ENGINE_URL=http://localhost:${AI_ENGINE_PORT}
KIT_ORCHESTRATOR_URL=http://localhost:${KIT_ORCHESTRATOR_PORT}
EXPORT_SERVICE_URL=http://localhost:${EXPORT_SERVICE_PORT}

# ─── File Storage ──────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
# For S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# ─── Stripe (Phase 2) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_FREE_KITS_PER_MONTH=3
RATE_LIMIT_FREE_REQUESTS_PER_MINUTE=10
RATE_LIMIT_PRO_REQUESTS_PER_MINUTE=60

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
