# direnv config — auto-activates venv-ai when entering this directory.
# Install direnv (brew install direnv) and run `direnv allow` here.
export VIRTUAL_ENV="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)/venv-ai"
export PATH="$VIRTUAL_ENV/bin:$PATH"
export PYTHONPATH="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd):$PYTHONPATH"
